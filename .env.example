# VARA STORIES — Environment Configuration Example

# Public website URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://varastories.com

# Studio WhatsApp Number (digits only including country code, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Studio Brand Name
NEXT_PUBLIC_STUDIO_NAME="VARA STORIES"

# Optional: Studio Email for direct enquiries (leave empty if not configured)
# NEXT_PUBLIC_STUDIO_EMAIL=

# Optional: Studio Instagram profile URL (leave empty if not configured)
# NEXT_PUBLIC_INSTAGRAM_URL=
